{
  "manifest_version": 3,
  "name": "FE Export",
  "version": "0.7.3",
  "description": "Export FullEnrich people search results to CSV with full profiles: job history, role descriptions, company data, skills, languages, education. From a list of LinkedIn URLs. Read only, no credits.",
  "permissions": [
    "activeTab",
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://app.fullenrich.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "FE Export",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://app.fullenrich.com/*"
      ],
      "js": [
        "main-world.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://app.fullenrich.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "author": "Asad Ullah <asadbahi5033@gmail.com>",
  "homepage_url": "https://github.com/asadullah231/fullenrich-exporter",
  "background": {
    "service_worker": "background.js"
  }
}
